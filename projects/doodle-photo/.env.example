# Copy to .env on the server, then set your Moonshot API key.
DOODLE_API_KEY=
DOODLE_API_BASE=https://api.moonshot.cn/v1
DOODLE_MODEL=kimi-k2.6
# Optional: absolute path to the SAM weights; without weights, outlines are skipped.
# SAM_CHECKPOINT=/opt/doodle-photo/sam_vit_b_01ec64.pth
# SAM_MODEL_TYPE=vit_b
